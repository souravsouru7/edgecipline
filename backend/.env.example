# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_BYTE_HEX_SECRET
# Separate secret for admin tokens — prevents user tokens being accepted by admin middleware.
# If omitted, falls back to JWT_SECRET (safe for single-server setups, but set this in production).
ADMIN_JWT_SECRET=REPLACE_WITH_DIFFERENT_64_BYTE_HEX_SECRET
# JWT_EXPIRES_IN — legacy config fallback; keep at 15m to match JWT_ACCESS_EXPIRES_IN
JWT_EXPIRES_IN=15m
# JWT_ACCESS_EXPIRES_IN — used by tokenService.js for access token lifetime (default 15m)
JWT_ACCESS_EXPIRES_IN=15m
# REFRESH_TOKEN_EXPIRY_MS — used by tokenService.js for refresh token lifetime (default 30 days)
REFRESH_TOKEN_EXPIRY_MS=2592000000

# ─── MongoDB ──────────────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGO_DNS_SERVERS=8.8.8.8,1.1.1.1

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Cloudinary ───────────────────────────────────────────────────────────────
CLOUD_NAME=REPLACE_WITH_CLOUDINARY_CLOUD_NAME
CLOUD_API_KEY=REPLACE_WITH_CLOUDINARY_API_KEY
CLOUD_API_SECRET=REPLACE_WITH_CLOUDINARY_API_SECRET

# ─── Google AI (Gemini) ───────────────────────────────────────────────────────
GEMINI_API_KEY=REPLACE_WITH_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.5-flash

# ─── Firebase Admin SDK ───────────────────────────────────────────────────────
# Download service account JSON from Firebase Console → Project Settings → Service Accounts
FIREBASE_PROJECT_ID=REPLACE_WITH_FIREBASE_PROJECT_ID
FIREBASE_CLIENT_EMAIL=REPLACE_WITH_FIREBASE_CLIENT_EMAIL
# Paste the private key with literal \n sequences (keep the surrounding quotes)
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_ACTUAL_KEY\n-----END PRIVATE KEY-----\n"

# ─── Razorpay (optional — leave blank to disable online payments) ──────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ─── Resend (transactional email — OTP, renewal reminders) ────────────────────
# Get your API key from resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# From address — must be from a verified domain in your Resend account
RESEND_FROM=Stratedge <noreply@stratedge.live>

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost,https://localhost,capacitor://localhost,https://yourdomain.com
# Comma-separated list of specific Vercel preview URLs allowed in production.
# Do NOT use a wildcard — list each URL explicitly.
# Example: https://myapp-git-staging-team.vercel.app,https://myapp-abc123.vercel.app
ALLOWED_VERCEL_PREVIEWS=

# ─── Sentry ───────────────────────────────────────────────────────────────────
# Get DSN from sentry.io → your project → Settings → Client Keys
SENTRY_DSN=
