souravNODE_ENV=development
COOKIE_CROSS_SITE=false

# Backend
PORT=5000
MONGO_URI=your_mongodb_uri_here
# Generate JWT_SECRET and ADMIN_JWT_SECRET separately:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Minimum: 32 characters. Values must be different.
JWT_SECRET=your_user_jwt_secret_min_32_chars
ADMIN_JWT_SECRET=your_admin_jwt_secret_min_32_chars
JWT_EXPIRES_IN=15m
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRY_MS=2592000000
REDIS_URL=redis://localhost:6379
RATE_LIMIT_REDIS_TIMEOUT_MS=1500
DEVICE_TOKEN_RATE_LIMIT_MAX_REQUESTS=20
PASSWORD_RESET_REQUEST_WINDOW_MS=60000
PASSWORD_RESET_REQUEST_MAX_REQUESTS=20
PASSWORD_RESET_EMAIL_WINDOW_MS=60000
PASSWORD_RESET_EMAIL_MAX_REQUESTS=10
OCR_COMPLETED_RETENTION_AGE_SECONDS=86400
OCR_COMPLETED_RETENTION_COUNT=10000
OCR_FAILED_RETENTION_AGE_SECONDS=604800
OCR_FAILED_RETENTION_COUNT=10000
OCR_QUEUE_RECOVERY_ATTEMPTS=2
OCR_WORKER_MAX_STALLED_COUNT=2
TRUST_PROXY=false

# Observability
SENTRY_DSN=your_backend_sentry_dsn_here
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=edgecipline-api@1.0.0
SENTRY_TRACES_SAMPLE_RATE=0.2
SENTRY_ANDROID_DSN=your_android_sentry_dsn_here
SENTRY_ORG=your_sentry_org
SENTRY_PROJECT=your_sentry_project
SENTRY_AUTH_TOKEN=your_ci_only_sentry_auth_token

# Cloudinary
CLOUD_NAME=your_cloudinary_cloud_name_here
CLOUD_API_KEY=your_cloudinary_api_key_here
CLOUD_API_SECRET=your_cloudinary_api_secret_here

# AI/OCR providers
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=your_openai_api_key_here
GOOGLE_VISION_PROJECT_ID=your_google_vision_project_id_here
GOOGLE_VISION_CLIENT_EMAIL=your_google_vision_client_email_here
GOOGLE_VISION_PRIVATE_KEY=your_google_vision_private_key_here

# Firebase Admin
FIREBASE_PROJECT_ID=your_firebase_project_id_here
FIREBASE_CLIENT_EMAIL=your_firebase_client_email_here
FIREBASE_PRIVATE_KEY=your_firebase_private_key_here

# Payments and email
# Test mode uses rzp_test_* keys; production requires rzp_live_*.
RAZORPAY_KEY_ID=rzp_test_replace_with_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
# Generated in Razorpay Dashboard > Settings > Webhooks when you create the
# webhook. This is a SEPARATE secret from RAZORPAY_KEY_SECRET and must never
# be set to the same value — it is the only thing standing between a forged
# HTTP request and a free subscription. Without it every webhook 503s.
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Demo checkout that activates a REAL subscription from a fabricated payment
# id. Leave false everywhere that points at a real database. Ignored entirely
# when NODE_ENV=production — production cannot opt in.
ALLOW_SANDBOX_PAYMENTS=false

# Webhook safety nets. Reconciliation replays events whose processing failed
# until Razorpay stopped retrying; retention drops stored payloads after the
# window (the event document itself is kept forever for replay protection).
ENABLE_WEBHOOK_RECONCILIATION_CRON=true
WEBHOOK_RECONCILIATION_CRON=*/15 * * * *
WEBHOOK_RECONCILIATION_BATCH_SIZE=50
ENABLE_WEBHOOK_RETENTION_CRON=true
WEBHOOK_RETENTION_CRON=30 3 * * *
WEBHOOK_RETENTION_DAYS=90
WEBHOOK_RETENTION_BATCH_SIZE=500
RESEND_API_KEY=your_resend_api_key_here
# The domain in RESEND_FROM must be added AND verified at resend.com/domains.
# An unverified domain makes Resend reject every send with 403 "the <domain>
# domain is not verified", which surfaces to users as a failed password reset.
# Until a domain is verified you can use the sandbox sender below, but it only
# delivers to the Resend account owner's own address:
#   RESEND_FROM=Edgecipline <onboarding@resend.dev>
RESEND_FROM=Edgecipline <noreply@your-verified-domain.com>
RESEND_TEST_TO=you@example.com
# Sanity-check the sender before trusting the reset flow:
#   cd backend && node scripts/test-resend.js you@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user_here
SMTP_PASS=your_smtp_password_here
SMTP_FROM=noreply@example.com

# Frontend public config
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_FIREBASE_API_KEY=your_public_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_firebase_project_id_here
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id_here
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id_here
NEXT_PUBLIC_FIREBASE_WEB_CLIENT_ID=your_web_client_id_here
# Publishable key only — never the key secret. Safe to ship in the bundle.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_replace_with_public_key_id
# Build-time kill switch for the entire purchase surface. Next.js inlines
# NEXT_PUBLIC_* at compile time, so `false` makes the paywall, the Razorpay
# checkout loader and the sandbox mock statically dead code that the minifier
# drops — not merely hidden UI.
#
# MUST stay false for Capacitor Android/iOS builds: Apple 3.1.1 rejects a
# third-party payment processor in-app, and Play treats a simulated checkout
# that grants a paid plan as deceptive behaviour. canShowPurchaseUI() also
# blocks native at runtime, but this flag is what keeps the code out entirely.
NEXT_PUBLIC_PAYMENTS_ENABLED=false

# ── Free trade allowance ────────────────────────────────────────────────────
# Free accounts may log FREE_TRADE_LIMIT trades in EACH market (Forex and
# Indian counted separately). Premium — an active paid plan, the 7-day trial,
# or an admin — is unlimited.
# The 7-day free trial is RETIRED — the free tier is the trade allowance below
# and nothing else. Set TRIAL_ENABLED=true to bring it back wholesale (granted
# on signup, countdown banner, trial users counting as premium).
TRIAL_ENABLED=false
TRIAL_DAYS=7

FREE_TRADE_LIMIT=2
# Kill switch. The limit is only fair while there is somewhere to pay: with
# NEXT_PUBLIC_PAYMENTS_ENABLED=false the purchase surface is compiled out of
# the build entirely, so an enforced limit leaves free users stuck with no way
# to unblock themselves. Keep this false until checkout is live. The server
# logs TRADE_LIMIT_ENFORCED_WITHOUT_CHECKOUT at boot if this is on while
# Razorpay is unconfigured.
FREE_TRADE_LIMIT_ENFORCED=false
NEXT_PUBLIC_SENTRY_DSN=your_public_sentry_dsn_here
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_RELEASE=edgecipline-web@1.0.0
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.2

# ── Customer support ────────────────────────────────────────────────────────
# Read by the backend and served to the frontend from GET /api/support/config.
# Deliberately NOT NEXT_PUBLIC_*: /support is a URL submitted to Google Play and
# App Store Connect, and the web build is a static export — a number baked into
# the bundle cannot be corrected without shipping a new release to both stores.
SUPPORT_WHATSAPP_NUMBER=917510606322
SUPPORT_WHATSAPP_ENABLED=true
SUPPORT_EMAIL=info@edgecipline.com
# Kill switch for the ticket surface only. With this false the Help Center still
# serves articles and the WhatsApp/email CTAs — self-service and the external
# channels must never depend on the ticket system being healthy.
SUPPORT_TICKETS_ENABLED=true
SUPPORT_MAX_ATTACHMENTS=5
SUPPORT_MAX_ATTACHMENT_BYTES=5242880
# Lifetime of the signed URL handed out for an attachment download. Long enough
# for a browser to follow the redirect, short enough that a URL copied out of
# devtools is dead within the minute.
SUPPORT_ATTACHMENT_URL_TTL_SECONDS=60
# Open tickets one customer may hold at once, before new creates are refused.
SUPPORT_MAX_OPEN_TICKETS_PER_USER=10
# Nightly sweep that closes resolved tickets past the 7-day reopen window.
ENABLE_SUPPORT_AUTO_CLOSE_CRON=true
SUPPORT_AUTO_CLOSE_CRON=0 2 * * *
SUPPORT_AUTO_CLOSE_BATCH_SIZE=500
# Ticket emails ride the existing Resend sender (RESEND_FROM). Independent of
# push: a customer with notifications off on their phone still needs the reply.
SUPPORT_EMAIL_NOTIFICATIONS_ENABLED=true
SUPPORT_APP_BASE_URL=https://stratedge.live
# Salt for the anonymous article-feedback fingerprint. Any random 32+ char
# string. Rotating it resets one-vote-per-visitor tracking; it is never stored
# or transmitted, only hashed with the visitor IP + user agent.
SUPPORT_FEEDBACK_FINGERPRINT_SALT=replace_with_a_long_random_string_min_32
# Per-user support limits.
SUPPORT_TICKET_CREATE_RATE_LIMIT_MAX=5
SUPPORT_MESSAGE_RATE_LIMIT_MAX=30
SUPPORT_SEARCH_RATE_LIMIT_MAX=60
SUPPORT_ARTICLE_FEEDBACK_RATE_LIMIT_MAX=20
