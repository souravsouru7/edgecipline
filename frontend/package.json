{
  "name": "trading-journal-client",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test scripts/test-notification-routes.mjs scripts/test-mobile-shell.mjs features/trade/data/demoExtractionFixtures.test.mjs features/onboarding/utils/*.test.mjs features/premium/utils/*.test.mjs",
    "test:notifications": "node --test scripts/test-notification-routes.mjs",
    "android": "npm run build:mobile && npx cap sync android && npx cap open android",
    "android:sync": "npm run build:mobile && npx cap sync android",
    "android:build": "npm run build:mobile && npx cap sync android && node scripts/run-gradle-release.mjs",
    "ios": "npm run build:mobile && npx cap sync ios && npx cap open ios",
    "ios:sync": "npm run build:mobile && npx cap sync ios",
    "build:mobile": "next build && node scripts/prune-mobile-bundle.mjs"
  },
  "dependencies": {
    "@capacitor-firebase/authentication": "^6.3.1",
    "@capacitor/android": "^6.2.1",
    "@capacitor/app": "^6.0.3",
    "@capacitor/core": "^6.2.1",
    "@capacitor/haptics": "^6.0.3",
    "@capacitor/ios": "^6.2.1",
    "@capacitor/keyboard": "^6.0.4",
    "@capacitor/network": "^6.0.4",
    "@capacitor/preferences": "^6.0.4",
    "@capacitor/push-notifications": "^6.0.0",
    "@capacitor/status-bar": "^6.0.3",
    "@sentry/capacitor": "4.1.0",
    "@sentry/nextjs": "10.52.0",
    "@sentry/react": "10.52.0",
    "@tanstack/query-sync-storage-persister": "^5.103.1",
    "@tanstack/react-query": "^5.96.2",
    "@tanstack/react-query-persist-client": "^5.103.1",
    "axios": "^1.14.0",
    "axios-retry": "^4.5.0",
    "firebase": "^11.10.0",
    "framer-motion": "^12.36.0",
    "html-to-image": "^1.11.13",
    "lucide-react": "^0.577.0",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-joyride": "^3.1.0",
    "recharts": "^3.7.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "playwright": "^1.62.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
