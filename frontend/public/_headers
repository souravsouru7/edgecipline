# Cloudflare static-asset headers. Copied to out/_headers by `next build`.
#
# next.config.ts declares these via headers(), but that only runs in the dev
# server and SSR deployments — `output: "export"` emits plain files, so the
# config block has no effect on the deployed site. This file is what actually
# sets them, and it keeps the two in sync.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

/accept-terms*
  Cache-Control: no-store, no-cache, must-revalidate, proxy-revalidate
  Pragma: no-cache
  Expires: 0

