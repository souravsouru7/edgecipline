<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:networkSecurityConfig="@xml/network_security_config">

        <meta-data android:name="io.sentry.auto-init" android:value="true" tools:replace="android:value" />
        <meta-data android:name="io.sentry.dsn" android:value="${sentryDsn}" />
        <meta-data android:name="io.sentry.send-default-pii" android:value="false" />

        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_edgecipline" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_accent" />
        <!--
            Default channel for FCM data-messages that omit channelId.
            edgecipline_insights is medium importance with no sound — safe
            fallback. The backend explicitly sets channelId per type, so this
            only fires when the backend payload is malformed.
        -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="edgecipline_insights" />

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- ── Checklist Notification: BroadcastReceiver for item toggle/reset ── -->
        <receiver
            android:name=".ChecklistActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.edgecipline.CHECKLIST_TOGGLE" />
                <action android:name="com.edgecipline.CHECKLIST_RESET" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".ChecklistAlarmReceiver"
            android:exported="false" />

        <!-- ── Checklist Notification: Reschedule WorkManager after device reboot ── -->
        <receiver
            android:name=".ChecklistBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <!-- HTC / OnePlus quick-boot -->
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

    </application>

    <!-- ── Core permissions ──────────────────────────────────────────────── -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Google Play Billing. The billing library declares this itself and the
         manifest merger would add it regardless, but Play Console's release
         review lists app permissions from the merged manifest and reviewers
         expect to see it declared by an app that sells subscriptions. -->
    <uses-permission android:name="com.android.vending.BILLING" />

    <!-- Camera and storage for trade screenshot upload -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <!-- Android 13+ image picker.
         Play's Photo and Video Permissions policy requires a declaration in
         the Play Console for READ_MEDIA_IMAGES, and expects broad library
         access to be core functionality. Reading broker screenshots from the
         gallery is the app's primary import path, so it qualifies — but the
         declaration form still has to be completed before release. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <!-- Android 14+ partial ("Select photos") access. Without this, users who
         grant access to only some photos are treated as having denied it. -->
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <!-- Android 12 and below -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- ── Notification permissions ─────────────────────────────────────── -->
    <!-- FCM push notifications (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- WorkManager: keep scheduled jobs alive after reboot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
        SCHEDULE_EXACT_ALARM deliberately NOT declared.

        Google Play restricts it to apps whose core function is an alarm clock
        or calendar, behind a sensitive-permission declaration; a trading
        checklist reminder does not qualify, and on Android 14+ it is denied by
        default anyway. ChecklistScheduler.scheduleExactAlarm() already checks
        canScheduleExactAlarms() and returns early when it is unavailable,
        leaving the WorkManager job — which is always enqueued first — as the
        delivery path. Reminders fire within WorkManager's normal batching
        window instead of to the exact second.

        The explicit FOREGROUND_SERVICE declaration was also removed — but note
        the permission still appears in the MERGED manifest, and that is
        correct. androidx.work declares it, and ChecklistScheduler /
        ChecklistAlarmReceiver both enqueue work with setExpedited(); below
        API 31 WorkManager runs expedited work as a foreground service, and
        minSdk here is 24. Do NOT strip it with tools:node="remove" — that
        breaks checklist reminders on Android 7-11.
    -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

</manifest>
