<?xml version="1.0" encoding="utf-8"?>
<!--
  Expanded interactive checklist notification.
  Supports up to 8 items — rows beyond the actual count are set to GONE.
  Each item row has an icon (checked/unchecked) and a label TextView.
  The entire row is wrapped in a clickable LinearLayout with a PendingIntent.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <!-- Progress bar -->
    <ProgressBar
        android:id="@+id/notif_progress_bar"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginBottom="10dp"
        android:max="100"
        android:progress="0"
        android:progressTint="#0D9E6E"
        android:progressBackgroundTint="#E2E8F0" />

    <!-- Progress text -->
    <TextView
        android:id="@+id/notif_progress_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="0 / 0 Completed"
        android:textColor="#64748B"
        android:textSize="11sp" />

    <!-- Item 0 -->
    <LinearLayout
        android:id="@+id/notif_item_row_0"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <ImageView
            android:id="@+id/notif_item_icon_0"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_notif_unchecked"
            android:contentDescription="Toggle item" />

        <TextView
            android:id="@+id/notif_item_label_0"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#0F1923"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Item 1 -->
    <LinearLayout
        android:id="@+id/notif_item_row_1"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/notif_item_icon_1"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_notif_unchecked"
            android:contentDescription="Toggle item" />

        <TextView
            android:id="@+id/notif_item_label_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#0F1923"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Item 2 -->
    <LinearLayout
        android:id="@+id/notif_item_row_2"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/notif_item_icon_2"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_notif_unchecked"
            android:contentDescription="Toggle item" />

        <TextView
            android:id="@+id/notif_item_label_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#0F1923"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Item 3 -->
    <LinearLayout
        android:id="@+id/notif_item_row_3"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/notif_item_icon_3"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_notif_unchecked"
            android:contentDescription="Toggle item" />

        <TextView
            android:id="@+id/notif_item_label_3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#0F1923"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Item 4 -->
    <LinearLayout
        android:id="@+id/notif_item_row_4"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/notif_item_icon_4"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_notif_unchecked"
            android:contentDescription="Toggle item" />

        <TextView
            android:id="@+id/notif_item_label_4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#0F1923"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Item 5 -->
    <LinearLayout
        android:id="@+id/notif_item_row_5"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/notif_item_icon_5"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_notif_unchecked"
            android:contentDescription="Toggle item" />

        <TextView
            android:id="@+id/notif_item_label_5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#0F1923"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Item 6 -->
    <LinearLayout
        android:id="@+id/notif_item_row_6"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/notif_item_icon_6"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_notif_unchecked"
            android:contentDescription="Toggle item" />

        <TextView
            android:id="@+id/notif_item_label_6"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#0F1923"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Item 7 -->
    <LinearLayout
        android:id="@+id/notif_item_row_7"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/notif_item_icon_7"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_notif_unchecked"
            android:contentDescription="Toggle item" />

        <TextView
            android:id="@+id/notif_item_label_7"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#0F1923"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="4dp"
        android:background="#E2E8F0" />

    <!-- Open App action -->
    <TextView
        android:id="@+id/notif_btn_open"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:gravity="center"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="Open Checklist"
        android:textColor="#0D9E6E"
        android:textSize="12sp"
        android:textStyle="bold" />

</LinearLayout>
