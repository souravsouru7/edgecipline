<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ splash screen: plain brand background, no icon.
         The system splash can only show a circle-masked icon, never the full
         wordmark, so showing the "E" here meant the logo jumped from a big
         centred "E" to BrandOpener's wordmark when the WebView painted. With a
         blank icon the logo is drawn once, by BrandOpener, and never moves.
         (Android 11 and older use drawable/splash.xml, which matches BrandOpener.) -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_blank</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/splash_background</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="android:background">@drawable/splash</item>
    </style>
</resources>
