<?xml version="1.0" encoding="utf-8"?>
<!--
  Boot splash painted by AndroidX SplashScreen before the WebView exists.

  This was a single 13199x4500 PNG used as a full-bleed android:background,
  which Android stretched to the screen's aspect ratio: the logo rendered
  blurry, at a size that matched nothing, and the device had to decode a
  59-megapixel bitmap on every cold start.

  A layer-list instead: a flat brand-coloured ground plus the logo centred at
  its natural size, supplied per density (drawable-*dpi/splash_logo.png at
  230dp wide). 230dp is also the width BrandOpener draws its mark at, so the
  native splash and the web opener put the same logo in the same place — the
  hand-off between them is invisible rather than the logo appearing twice at
  two different sizes.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/splash_background" />
    <item>
        <bitmap
            android:src="@drawable/splash_logo"
            android:gravity="center"
            android:antialias="true"
            android:filter="true" />
    </item>
</layer-list>
